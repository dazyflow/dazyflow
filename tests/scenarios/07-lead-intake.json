{
  "id": "lead-intake",
  "version": "1",
  "tenant": "dev",
  "workspace": "default",
  "triggers": [{"type": "webhook", "secret": "REPLACE_WITH_WEBHOOK_SECRET", "public_form": true}],
  "nodes": [
    {
      "id": "intake",
      "module": "webhook_input",
      "params": {}
    },
    {
      "id": "store_lead",
      "module": "builtin_store_append",
      "params": {"table": "leads"}
    }
  ],
  "edges": [
    {"from": "intake", "from_port": "body", "to": "store_lead", "to_port": "rows"}
  ]
}
