{
  "id": "recurring-invoices",
  "version": "1",
  "tenant": "dev",
  "workspace": "default",
  "triggers": [{"type": "cron", "cron": "0 9 1 * *"}],
  "nodes": [
    {
      "id": "read_clients",
      "module": "sheets_read_range",
      "params": {"account": "default", "spreadsheet_id": "REPLACE_WITH_SHEET_ID", "range": "RecurringClients"}
    },
    {
      "id": "invoice_each_client",
      "module": "for_each",
      "params": {}
    },
    {
      "id": "send_invoice",
      "module": "gmail_send_email",
      "params": {
        "account": "default",
        "to": "${item.email}",
        "subject": "Your recurring invoice",
        "body": "Hi ${item.name}, your recurring invoice for ${item.amount} is ready. Thank you for your business."
      }
    }
  ],
  "edges": [
    {"from": "read_clients", "from_port": "rows", "to": "invoice_each_client", "to_port": "items"},
    {"from": "invoice_each_client", "from_port": "body", "to": "send_invoice", "to_port": "pass"}
  ]
}
