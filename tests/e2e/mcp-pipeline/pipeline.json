{
  "id": "mcp-lookup-and-route",
  "version": "1",
  "tenant": "dev",
  "workspace": "main",
  "nodes": [
    {
      "id": "lookup",
      "module": "mcp:ap-demo:lookup_user",
      "params": {"id": "alice"}
    },
    {
      "id": "is_premium",
      "module": "compare",
      "params": {"field": "tier", "op": "equals", "B": "premium"}
    },
    {
      "id": "route",
      "module": "branch"
    },
    {
      "id": "save_premium",
      "module": "file_write",
      "params": {"path": "users/premium.json", "mkdirs": true}
    },
    {
      "id": "save_regular",
      "module": "file_write",
      "params": {"path": "users/regular.json", "mkdirs": true}
    }
  ],
  "edges": [
    {"from": "lookup", "from_port": "out", "to": "is_premium", "to_port": "A"},
    {"from": "is_premium", "from_port": "result", "to": "route", "to_port": "condition"},
    {"from": "lookup", "from_port": "out", "to": "route", "to_port": "in"},
    {"from": "route", "from_port": "then", "to": "save_premium", "to_port": "in"},
    {"from": "route", "from_port": "else", "to": "save_regular", "to_port": "in"}
  ]
}
