{
  "id": "uc-renewal-reminders",
  "version": "1",
  "tenant": "dev",
  "workspace": "default",
  "name": "Warn me 30 days before a contract renews",
  "triggers": [
    {
      "type": "cron",
      "cron": "0 8 * * *",
      "tz": "Europe/Stockholm"
    }
  ],
  "nodes": [
    {
      "id": "read",
      "module": "sheets_read_range",
      "params": {
        "spreadsheet_id": "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789",
        "range": "Contracts",
        "headers": true,
        "row_numbers": true,
        "account": "default"
      }
    },
    {
      "id": "due",
      "module": "compute_rows",
      "params": {
        "filter": "row.reminded_on == '' && timestamp(row.end_date + 'T00:00:00Z') > now && timestamp(row.end_date + 'T00:00:00Z') < now + duration('720h')"
      }
    },
    {
      "id": "each",
      "module": "for_each",
      "params": {
        "concurrency": 2
      }
    },
    {
      "id": "tell_owner",
      "module": "email_send",
      "params": {
        "to": "${item.owner_email}",
        "subject": "Renewal coming up: ${item.customer}",
        "body": "The contract with ${item.customer} ends on ${item.end_date} — that's inside 30 days. Renew, renegotiate or let it lapse; either way it needs a decision this month.",
        "format": "text"
      }
    },
    {
      "id": "mark_row",
      "module": "expression",
      "params": {
        "expr": "[{'_row': ${item._row}, 'reminded_on': string(now)}]"
      }
    },
    {
      "id": "write_back",
      "module": "sheets_update_cells",
      "params": {
        "spreadsheet_id": "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789",
        "range": "Contracts",
        "columns": [
          "reminded_on"
        ],
        "account": "default"
      }
    }
  ],
  "edges": [
    {
      "from": "read",
      "from_port": "rows",
      "to": "due",
      "to_port": "rows"
    },
    {
      "from": "due",
      "from_port": "rows",
      "to": "each",
      "to_port": "items"
    },
    {
      "from": "each",
      "from_port": "body",
      "to": "tell_owner",
      "to_port": "pass"
    },
    {
      "from": "tell_owner",
      "from_port": "pass",
      "to": "mark_row",
      "to_port": "in"
    },
    {
      "from": "mark_row",
      "from_port": "out",
      "to": "write_back",
      "to_port": "rows"
    }
  ]
}
