{
 "id": "uc-invoices-from-my-own-mail-server",
 "version": "1",
 "tenant": "dev",
 "workspace": "default",
 "name": "Invoices arriving at my own mail server → filed in Drive and marked done",
 "nodes": [
  {
   "id": "poll",
   "module": "poll_trigger",
   "params": {
    "interval_seconds": 900
   }
  },
  {
   "id": "search",
   "module": "imap_search_messages",
   "params": {
    "subject": "invoice",
    "only_new": true,
    "limit": 20
   }
  },
  {
   "id": "each",
   "module": "for_each",
   "params": {
    "concurrency": 1
   }
  },
  {
   "id": "attachments",
   "module": "imap_get_attachments",
   "params": {
    "id": "${item.id}",
    "only": "pdf"
   }
  },
  {
   "id": "file_it",
   "module": "drive_upload",
   "params": {
    "account": "default",
    "folder_id": "1FoLdErIdFrOmYoUrDrIvE",
    "name": "${item.subject}.pdf"
   }
  },
  {
   "id": "read_it",
   "module": "imap_get_message",
   "params": {
    "id": "${item.id}"
   }
  },
  {
   "id": "extract",
   "module": "claude_extract",
   "params": {
    "fields": [
     {
      "name": "vendor",
      "description": "the company that sent the invoice"
     },
     {
      "name": "amount",
      "description": "total amount due"
     },
     {
      "name": "due_date",
      "description": "payment due date, YYYY-MM-DD"
     }
    ]
   }
  },
  {
   "id": "rows",
   "module": "parse_json",
   "params": {}
  },
  {
   "id": "log",
   "module": "sheets_append_row",
   "params": {
    "account": "default",
    "spreadsheet_id": "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789",
    "range": "Invoices"
   }
  },
  {
   "id": "mark_done",
   "module": "imap_mark_seen",
   "params": {
    "id": "${item.id}"
   }
  }
 ],
 "edges": [
  {
   "from": "poll",
   "from_port": "pass",
   "to": "search",
   "to_port": "pass"
  },
  {
   "from": "search",
   "from_port": "messages",
   "to": "each",
   "to_port": "items"
  },
  {
   "from": "each",
   "from_port": "body",
   "to": "attachments",
   "to_port": "pass"
  },
  {
   "from": "attachments",
   "from_port": "first",
   "to": "file_it",
   "to_port": "in"
  },
  {
   "from": "attachments",
   "from_port": "count",
   "to": "read_it",
   "to_port": "pass"
  },
  {
   "from": "read_it",
   "from_port": "body",
   "to": "extract",
   "to_port": "text"
  },
  {
   "from": "extract",
   "from_port": "data",
   "to": "rows",
   "to_port": "in"
  },
  {
   "from": "rows",
   "from_port": "rows",
   "to": "log",
   "to_port": "rows"
  },
  {
   "from": "log",
   "from_port": "pass",
   "to": "mark_done",
   "to_port": "pass"
  }
 ]
}
