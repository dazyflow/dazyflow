# HTTPS for the apex and per-org subdomains. Caddy provisions and renews certs
# via Let's Encrypt (ACME_EMAIL from .env), forwards X-Forwarded-Proto and
# upgrades WebSocket/SSE, so dzd only needs DAZYFLOW_TRUST_PROXY_HEADERS=1.
#
# Per-org subdomains use ON-DEMAND TLS instead of a wildcard cert (which would
# need DNS-01 and a DNS-provider plugin in a custom image). The `ask` endpoint
# gates issuance on dzd, which answers 2xx only for subdomains an org has
# CLAIMED, so strangers cannot burn Let's Encrypt rate limits on random hosts.
# Requires the wildcard DNS record `*.<apex>`.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://dzd:8080/api/v1/auth/tls-allow
	}
}

# Apex — a normal managed certificate (HTTP-01), provisioned up front.
dazyflow.app {
	reverse_proxy dzd:8080
}

# Documentation site (docs.dazyflow.app): Caddy terminates TLS and proxies to
# the nginx `docs` container (Dockerfile.docs, docker-compose.prod.yml).
#
# TLS is ON-DEMAND on purpose. `docs` matches the `*.dazyflow.app` on-demand
# policy below, and Caddy excludes any such name from up-front issuance, so an
# explicit managed cert here would never be obtained and every handshake would
# fail. The `ask` endpoint authorizes it via auth.servedInfraSubdomains.
docs.dazyflow.app {
	tls {
		on_demand
	}
	reverse_proxy docs:80
}

# Per-org subdomains — one on-demand cert per claimed org host, authorized by
# the `ask` endpoint above. Same dzd upstream; the sign-in handoff state is
# in-process, so every *.apex host MUST reach the same dzd (one upstream here
# satisfies that).
*.dazyflow.app {
	tls {
		on_demand
	}
	reverse_proxy dzd:8080
}
