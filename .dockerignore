# Keep the build context lean — these are regenerated in-image or
# irrelevant to the build.
.git
**/node_modules
web/dist
# Docs build output — generated fresh inside Dockerfile.docs (gen + vitepress
# stages), never copied from the host context.
docs/.vitepress/dist
docs/.vitepress/cache
.dazyflow-workspace
.dazyflow-sandbox
.dazyflow-users.json
*.log
OVERNIGHT.md

# Secrets and credentials must never enter the build context: the Dockerfile
# does `COPY . .`, which would otherwise bake them into an image layer.
.env
.env.*
!.env.example
certs/
*.key
*.pem
.dazyflow/
*.xlsx
