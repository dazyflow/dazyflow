# Keep the build context lean — these are regenerated in-image or
# irrelevant to the build.
.git
**/node_modules
web/dist
# The docs SPA's generated content tree and build output. Both are produced
# inside Dockerfile.docs (the `gen` stage runs cmd/docsgen, the `build` stage
# runs Vite), never copied from the host context.
web/src/docs/content
web/dist-docs
.dazyflow-workspace
.dazyflow-sandbox
*.log

# Secrets and credentials must never enter the build context: the Dockerfile
# does `COPY . .`, which would otherwise bake them into an image layer.
.env
.env.*
!.env.example
certs/
*.key
*.pem
.dazyflow/
*.xlsx
