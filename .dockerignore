# Keep the build context lean — these are regenerated in-image or
# irrelevant to the build.
.git
**/node_modules
web/dist
.hazyflow-workspace
.hazyflow-sandbox
.hazyflow-users.json
*.log
OVERNIGHT.md

# Secrets and credentials must never enter the build context: the Dockerfile
# does `COPY . .`, which would otherwise bake them into an image layer.
.env
.env.*
!.env.example
certs/
*.key
*.pem
.hazyflow/
*.xlsx
