{
  "id": "process-invoice-low",
  "version": "1",
  "tenant": "dev",
  "workspace": "default",
  "nodes": [
    {
      "id": "inbound",
      "module": "webhook_input",
      "params": {"secret": "webhook-secret"}
    },
    {
      "id": "fetch_invoice",
      "module": "http_request",
      "params": {
        "url": "http://127.0.0.1:60500/invoices/42",
        "headers": {"Authorization": "secret://INVOICE_API_KEY"},
        "allow_private_networks": true
      }
    },
    {
      "id": "is_big",
      "module": "compare",
      "params": {"field": "amount", "op": "greater_than", "B": 1000}
    },
    {
      "id": "classify",
      "module": "branch"
    },
    {
      "id": "notify_cfo",
      "module": "http_request",
      "params": {
        "url": "http://127.0.0.1:60500/notifications/cfo",
        "method": "POST",
        "headers": {
          "Authorization": "secret://SLACK_TOKEN",
          "Content-Type": "application/json"
        },
        "allow_private_networks": true
      }
    },
    {
      "id": "auto_approve",
      "module": "http_request",
      "params": {
        "url": "http://127.0.0.1:60500/approvals/auto",
        "method": "POST",
        "headers": {
          "Authorization": "secret://APPROVAL_API_KEY",
          "Content-Type": "application/json"
        },
        "allow_private_networks": true
      }
    },
    {
      "id": "archive",
      "module": "file_write",
      "params": {"path": "archive/invoice-42.json", "mkdirs": true}
    }
  ],
  "edges": [
    {"from": "fetch_invoice", "from_port": "response_body", "to": "is_big", "to_port": "A"},
    {"from": "is_big", "from_port": "result", "to": "classify", "to_port": "condition"},
    {"from": "fetch_invoice", "from_port": "response_body", "to": "classify", "to_port": "in"},
    {"from": "fetch_invoice", "from_port": "response_body", "to": "archive", "to_port": "in"},
    {"from": "classify", "from_port": "then", "to": "notify_cfo", "to_port": "request_body"},
    {"from": "classify", "from_port": "else", "to": "auto_approve", "to_port": "request_body"}
  ]
}
