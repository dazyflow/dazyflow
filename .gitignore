# Build outputs — rebuild with `make` / `go build`
/dzctl
/dzd
/docsgen
/transformer
/dz-drops
/dz-drophost
/ha_loadtest
/bin
# Legacy pre-rename binaries (hazyflow → dazyflow); were tracked by mistake.
/hzctl
/hzd

# Runtime data
/.dazyflow/
# Legacy runtime data dir (pre-rename). Held nested git repos recorded as
# gitlinks with no .gitmodules, which broke CI checkout's submodule init.
/.hazyflow/
*.xlsx
/.env
/certs/
/docker-compose.override.yml

# Build and tooling caches
/node_modules/
*.tsbuildinfo
/.vite/
web/.vite/
/runner/__pycache__

# Generated: SBOM artifacts (CI `sbom` task; attached to releases)
/sbom.spdx.json
/sbom.cdx.json
# Generated: docs SPA content (`make docs-content`) and its build
# (`make docs-site`). Guide pages are copied from docs/guide/, the step catalog
# is emitted by cmd/docsgen. Both are built fresh in CI and on deploy.
/web/src/docs/content/
/web/dist-docs/
# Generated: flow-generator eval reports (`make flowgen-eval`)
.flowgen-eval/

# Key material — never commit
.keys/
dazy-key
hazy-key

# Local tool state
/.claude/
/.mcp.json
/memory
