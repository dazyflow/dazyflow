# Compiled binaries (build outputs — never commit; rebuild with `make`/`go build`)
/dzctl
/dzd
# docsgen tool binary (from `go build ./cmd/docsgen`); the tool is source-only.
/docsgen
# Legacy pre-rename binary names (hazyflow → dazyflow); were tracked by mistake.
/hzctl
/hzd
/transformer
/dz-drops
/dz-drophost
/.dazyflow/
# Legacy runtime data dir (pre-rename). Was accidentally committed; held nested
# git repos recorded as gitlinks with no .gitmodules, which broke CI checkout's
# `git submodule update --init --recursive`.
/.hazyflow/
*.xlsx
/.env
/certs/

/node_modules/
# Build/tooling caches — regenerated, never commit
*.tsbuildinfo
/.vite/
web/.vite/
# Generated SBOM artifacts (produced by the CI `sbom` task; attached to releases)
/sbom.spdx.json
/sbom.cdx.json
# Generated step-catalog reference (produced by `make docs-reference` from the
# drop manifests). Source of truth is the manifests + cmd/docsgen; build in CI.
/docs/reference/steps/
# VitePress docs-site build artifacts + deps (docs.dazyflow.app). Built in CI
# with `make docs-site`; the source (docs/.vitepress/config.mts, guide/) is tracked.
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/docs/node_modules/
# Local key material (legacy dz-drops signing keys) — never commit
.keys/
# Dazy personal API key used by the complete-dazyflow-tasks skill — never commit
dazy-key
hazy-key
# Local Claude Code state stays out of git, but the shared skills under
# .claude/skills/ are committed so the team gets them.
/.claude/*
!/.claude/skills/
/.mcp.json
/docker-compose.override.yml
/bin
/memory
