# syntax=docker/dockerfile:1

# Docs site image for docs.dazyflow.app — the public docs SPA (React/Vite),
# which reuses the app's shell + design system (see web/src/docs/). Three stages:
#
#   1. gen   — cmd/docsgen generates the step-catalog Markdown from the live drop
#              manifests (needs the full Go module).
#   2. build — Vite builds the standalone docs bundle (web `build:docs`) after the
#              guide + generated catalog Markdown are dropped into the content dir.
#   3. final — nginx serves the SPA (client-side routing → index.html fallback).
#
# Built by the docker-compose prod overlay; the main Caddy reverse-proxies
# docs.dazyflow.app to this container. Nothing is built on the host.

# ---- 1. generate the step catalog -----------------------------------
FROM docker.io/library/golang:1.26.7-alpine AS gen
ENV GOTOOLCHAIN=local
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
# Same invocation as `make docs-content`'s generate step.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run ./cmd/docsgen -out /content/reference/steps

# ---- 2. build the docs SPA ------------------------------------------
FROM docker.io/library/node:22-alpine AS build
WORKDIR /web
# Deps first so this layer caches unless package.json / lock change.
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# Docs content: the hand-written guide (canonical in docs/guide/) plus the
# generated step catalog from stage 1. Both feed the content glob in
# src/docs/content.ts. The content dir is git-ignored (built fresh here).
COPY docs/guide/ ./src/docs/content/guide/
COPY --from=gen /content/reference/steps ./src/docs/content/reference/steps
RUN npm run build:docs
# nginx serves index.html; the Vite entry is docs.html.
RUN mv dist-docs/docs.html dist-docs/index.html

# ---- 3. runtime ------------------------------------------------------
FROM docker.io/library/nginx:1-alpine AS final
COPY --from=build /web/dist-docs /usr/share/nginx/html
COPY deploy/docs-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
