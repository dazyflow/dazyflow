# syntax=docker/dockerfile:1

# Docs site image for docs.dazyflow.app — the static VitePress build served by
# nginx. Three stages:
#
#   1. gen   — run cmd/docsgen to generate the step-catalog Markdown from the
#              live drop manifests (needs the full Go module, like `make
#              docs-reference`).
#   2. build — vitepress build → /docs/.vitepress/dist
#   3. final — nginx serving the static site with clean-URL resolution.
#
# Built by the docker-compose prod overlay; the main Caddy reverse-proxies
# docs.dazyflow.app to this container. Nothing is built on the host — this
# replaces the old `make docs-site` + bind-mount flow.

# ---- 1. generate the step catalog -----------------------------------
# docsgen imports the drop packages to read their manifests, so it compiles the
# whole module. Mirror the main Dockerfile's Go build knobs (pinned toolchain,
# overridable proxy, cache mounts) so this builds the same way in prod.
FROM golang:1.26.3-alpine AS gen
ENV GOTOOLCHAIN=local
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
# Same invocation as `make docs-reference`.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run ./cmd/docsgen -out docs/reference/steps

# ---- 2. vitepress build ---------------------------------------------
FROM node:22-alpine AS build
WORKDIR /docs
# Deps first so this layer caches unless package.json / lock change.
COPY docs/package.json docs/package-lock.json ./
RUN npm ci
# Hand-written source (config, guide, index). The generated reference tree is
# git-ignored, so it does NOT come from the context — it comes from `gen` next,
# which is the authoritative fresh generation.
COPY docs/ ./
COPY --from=gen /src/docs/reference/steps ./reference/steps
RUN npm run docs:build

# ---- 3. runtime ------------------------------------------------------
FROM nginx:1-alpine AS final
COPY --from=build /docs/.vitepress/dist /usr/share/nginx/html
COPY deploy/docs-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
