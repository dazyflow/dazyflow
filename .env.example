# Copy to `.env` and tune for your deployment. The root docker-compose.yml
# falls back to the defaults below, so `.env` is optional for the very
# first `docker compose up -d` — but you really should set the marked
# values before pointing real users at the box.
#
#   cp .env.example .env
#   docker compose up -d
#
# Brings up Postgres + the daemon, runs migrations, and serves the API +
# web UI on http://localhost:8080 (gRPC on :50050). Data persists in the
# named volumes, so `docker compose down` is safe.

# ---- Database -------------------------------------------------------
# DSN passed to the daemon. The bundled Postgres container in
# docker-compose.yml is fine for self-host; managed Postgres or an
# external box works the same way. When empty the daemon falls back to
# in-memory / JSON stores — dev only, lost on restart.
HAZYFLOW_POSTGRES_DSN=postgres://hazyflow:hazyflow@postgres:5432/hazyflow?sslmode=disable

# ---- Master key (strongly recommended) ------------------------------
# Base64-encoded 32-byte AES-256 key for the tenant:// encrypted secret
# store. Generate once with `openssl rand -base64 32` and keep a sealed
# backup — losing it makes every stored secret undecryptable, and every
# tenant must re-enter their credentials. When empty the tenant://
# scheme and /api/v1/secrets endpoints stay disabled (the daemon still
# boots).
HAZYFLOW_MASTER_KEY=

# ---- Public origin --------------------------------------------------
# Externally-reachable origin of this daemon (e.g. https://app.example.com).
# Required for OAuth — must match the redirect_uri registered with each
# provider — and for human-approval links. Leave blank for a local-only
# install that doesn't use either.
HAZYFLOW_PUBLIC_BASE_URL=

# ---- Web UI origin (CORS) -------------------------------------------
# Comma-separated allowed origins for the web UI (CORS + cookie
# credentials). For a single-host deploy the UI is served same-origin
# from :8080, so this is your public https origin. Defaults to
# http://localhost:8080 for first boot.
HAZYFLOW_WEB_ORIGIN=http://localhost:8080

# ---- Host bind (compose only) ---------------------------------------
# By default the app listens on 127.0.0.1:8080 so a reverse proxy
# (Caddy / nginx / Traefik) on the same host owns TLS + the public port.
# Set HAZYFLOW_BIND_ADDR=0.0.0.0 to expose directly (only sensible for a
# single-host deployment behind a firewall).
HAZYFLOW_BIND_ADDR=127.0.0.1
HAZYFLOW_PORT=8080

# ---- Reverse proxy --------------------------------------------------
# Honor X-Forwarded-Proto from the proxy when setting the Secure cookie
# flag + HSTS. Set to 1 ONLY behind a trusted TLS-terminating proxy; a
# directly-exposed daemon must leave this off so clients can't spoof the
# header.
HAZYFLOW_TRUST_PROXY_HEADERS=

# ---- Sign-up --------------------------------------------------------
# Set to 1 to enable POST /api/v1/auth/signup for self-serve account
# creation. Off by default — production deployments often prefer
# admin-invite-only.
HAZYFLOW_ENABLE_SIGNUP=

# ---- Session length -------------------------------------------------
# Lifetime of a sign-in session before the user must re-authenticate.
# Go duration string ("12h", "168h" for a week). Default 24h.
HAZYFLOW_SESSION_TTL=24h

# ---- Metrics --------------------------------------------------------
# Set to 1 to expose an unauthenticated GET /metrics Prometheus endpoint
# (per-tenant disk-usage gauges + liveness). Off by default — it reveals
# tenant names, so enable only behind a restricted monitoring network.
HAZYFLOW_ENABLE_METRICS=

# ---- Marketing landing page (optional) ------------------------------
# Path INSIDE the container to a static marketing site (the separate
# hazy-flow-landing repo: landing.html, style.css, /pricing, /privacy,
# /terms, assets). When set, GET / is auth-gated — anonymous visitors
# get landing.html, signed-in users get the app — and the marketing
# pages/assets serve publicly. Empty (the default) serves the app at /
# for everyone, which is the right posture for a private self-host
# install.
#
# The files live outside this repo, so mount them into the container and
# point this at the mount. Uncomment the `hzd.volumes` landing line in
# docker-compose.yml and set the host path there, then set:
#   HAZYFLOW_LANDING_DIR=/srv/landing
HAZYFLOW_LANDING_DIR=

# ---- Egress allowlist -----------------------------------------------
# Comma-separated allowlist for the http_request node: exact hosts
# (api.stripe.com), wildcards (*.slack.com), or CIDR/IP (203.0.113.0/24).
# Empty = allow any public host (the IP-level SSRF guard still blocks
# private addresses).
HAZYFLOW_HTTP_EGRESS_ALLOW=

# ---- AI chat agent (optional) ---------------------------------------
# Anthropic API key for the in-app chat agent. Empty disables
# /api/v1/chat/stream.
ANTHROPIC_API_KEY=

# ---- Inbound webhooks (optional) ------------------------------------
# Slack app Signing Secret — required for /api/v1/events/slack/* to
# accept Slack Events API POSTs. Empty disables the endpoint with 501.
HAZYFLOW_SLACK_SIGNING_SECRET=
# GitHub repo webhook Secret — required for /api/v1/events/github/* to
# accept push + pull_request POSTs. Empty disables the endpoint with 501.
HAZYFLOW_GITHUB_WEBHOOK_SECRET=

# ---- Approval links (optional) --------------------------------------
# Base64-encoded shared secret (>=16 bytes) for signing/verifying
# email/Slack approval-link tokens. Must be identical across nodes in a
# multi-node deployment. Requires HAZYFLOW_PUBLIC_BASE_URL.
HAZYFLOW_APPROVAL_HMAC_SECRET=

# ---- OAuth providers (optional) -------------------------------------
# Per-provider client credentials. Each pair registers that provider's
# "Connect" button in the UI. Requires HAZYFLOW_PUBLIC_BASE_URL so the
# redirect_uri can be built.
HAZYFLOW_OAUTH_SLACK_CLIENT_ID=
HAZYFLOW_OAUTH_SLACK_CLIENT_SECRET=
HAZYFLOW_OAUTH_GITHUB_CLIENT_ID=
HAZYFLOW_OAUTH_GITHUB_CLIENT_SECRET=
HAZYFLOW_OAUTH_GOOGLE_CLIENT_ID=
HAZYFLOW_OAUTH_GOOGLE_CLIENT_SECRET=
HAZYFLOW_OAUTH_NOTION_CLIENT_ID=
HAZYFLOW_OAUTH_NOTION_CLIENT_SECRET=

# ---- Connection pool (optional) -------------------------------------
# Size the shared Postgres pool for production: workers + gateway +
# scheduler all share it. Empty uses pgx defaults (max = max(4, NumCPU),
# min = 0).
HAZYFLOW_PG_MAX_CONNS=
HAZYFLOW_PG_MIN_CONNS=

# ---- Resource guards (optional) -------------------------------------
# Reject SubmitGraph above this many nodes (0 = unlimited). Guards against
# pathologically large graphs.
HAZYFLOW_MAX_GRAPH_NODES=
# Cap on node jobs a single tenant may run at once (0 = unlimited).
# Fairness throttle so one tenant can't monopolize the worker pool.
HAZYFLOW_MAX_CONCURRENT_JOBS=

# ---- Observability (optional) ---------------------------------------
# Export traces to an OpenTelemetry collector. Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Timezone -------------------------------------------------------
# Cron schedules are evaluated in this timezone — "0 8 * * *" means 08:00
# here, not 08:00 UTC.
TZ=UTC

# ---- Postgres container (compose only) ------------------------------
# Used by the bundled `postgres` service in docker-compose.yml. Change
# POSTGRES_PASSWORD before going to production (and update
# HAZYFLOW_POSTGRES_DSN above to match).
POSTGRES_DB=hazyflow
POSTGRES_USER=hazyflow
POSTGRES_PASSWORD=hazyflow
