# Copy to `.env` and tune for your deployment.
#
#   cp .env.example .env
#   docker compose up -d
#
# Brings up Postgres + the daemon and serves the API + web UI on
# http://localhost:8080 (gRPC on :50050). Data persists in the named
# volumes, so `docker compose down` is safe.
#
# IMPORTANT — fail-closed boot guard: dzd refuses to start when it's
# pointed at a database (the durable-deployment signal) while still using
# the bundled default DB password or an empty DAZYFLOW_MASTER_KEY. So
# before the first `docker compose up -d` you MUST set POSTGRES_PASSWORD
# (and a matching DAZYFLOW_POSTGRES_DSN) plus DAZYFLOW_MASTER_KEY below.
# For a throwaway local trial ONLY, set DAZYFLOW_DEV=1 to downgrade that
# guard to warnings — never do this in production.
#
# Configuration model: every knob is a DAZYFLOW_* env var. The daemon
# itself has only two flags, both one-shot operator commands:
# `--rotate-master-key` and `--import-users-from-json`. Anything you set
# below is the source of truth for the container.

# ---- Database (REQUIRED) --------------------------------------------
# DSN passed to the daemon. REQUIRED — dzd runs on Postgres and refuses to
# start without this. The bundled Postgres container in docker-compose.yml
# is fine for self-host; managed Postgres or an external box works the same
# way. Keep the host as `postgres` (the Compose service name): host-side
# `make dev` rewrites it to localhost automatically.
DAZYFLOW_POSTGRES_DSN=postgres://dazyflow:dazyflow@postgres:5432/dazyflow?sslmode=disable

# ---- Master key (REQUIRED for a durable deploy) ---------------------
# Base64-encoded 32-byte AES-256 key for the tenant:// encrypted secret
# store. Generate once with `openssl rand -base64 32` and keep a sealed
# backup — losing it makes every stored secret undecryptable, and every
# tenant must re-enter their credentials. When empty the tenant:// scheme
# and /api/v1/secrets endpoints are disabled; and when a database DSN is
# set, an empty key makes dzd refuse to boot (see the fail-closed guard at
# the top) unless DAZYFLOW_DEV=1.
DAZYFLOW_MASTER_KEY=

# ---- Two-factor auth key (optional) ---------------------------------
# Base64-encoded 32-byte AES-256 key that encrypts users' TOTP secrets at
# rest. Generate once with `openssl rand -base64 32` and keep a sealed
# backup — losing it forces every enrolled user to re-enrol their
# authenticator app. When empty, two-factor authentication is disabled
# install-wide: the /me/totp + /auth/totp endpoints return 503 and
# sign-in never asks for a second factor. A set-but-malformed value makes
# dzd refuse to boot rather than silently disabling 2FA.
DAZYFLOW_TOTP_KEY=

# ---- Public origin --------------------------------------------------
# Externally-reachable origin of this daemon (e.g. https://app.example.com).
# Required for OAuth — must match the redirect_uri registered with each
# provider — and for human-approval links. Leave blank for a local-only
# install that doesn't use either.
DAZYFLOW_PUBLIC_BASE_URL=

# ---- Web UI origin (CORS) -------------------------------------------
# Comma-separated allowed origins for the web UI (CORS + cookie
# credentials). For a single-host deploy the UI is served same-origin
# from :8080, so this is your public https origin. Defaults to
# http://localhost:8080 for first boot.
DAZYFLOW_WEB_ORIGIN=http://localhost:8080

# ---- Per-org subdomains (optional) ----------------------------------
# Set to your apex domain (e.g. dazyflow.app) to give each org its own
# subdomain: a visit to acme.dazyflow.app lands on the sign-in page with
# org=acme preselected. When set, every *.<domain> subdomain is accepted
# as a browser origin for CORS + the CSRF check (on top of the exact
# DAZYFLOW_WEB_ORIGIN entries), and Google/OAuth sign-in hands the
# session off to the originating subdomain so cookies stay host-only.
# Requires a wildcard DNS record (*.<domain>) and a wildcard TLS cert at
# the proxy, plus DAZYFLOW_PUBLIC_BASE_URL set to the apex (the OAuth
# redirect URI stays on the apex regardless of subdomain). Empty = off.
DAZYFLOW_WILDCARD_DOMAIN=

# ---- Host bind (compose only) ---------------------------------------
# By default the app listens on 127.0.0.1:8080 so a reverse proxy
# (Caddy / nginx / Traefik) on the same host owns TLS + the public port.
# Set DAZYFLOW_BIND_ADDR=0.0.0.0 to expose directly (only sensible for a
# single-host deployment behind a firewall).
DAZYFLOW_BIND_ADDR=127.0.0.1
DAZYFLOW_PORT=8080

# ---- Compose file set (production hosts) -----------------------------
# COMPOSE_FILE is read by docker compose ITSELF, not by dzd. Uncomment it
# on a host that runs the production overlay (Caddy for TLS + the docs
# site): every compose call then merges those two files — `make upgrade`,
# `make restart`, and a bare `docker compose up -d --build` alike — and
# the dev docker-compose.override.yml is no longer merged.
#
# Leave it commented on a dev machine or a plain single-container
# self-host. Without it, recreating the stack on a prod host would drop
# Caddy and the docs service. (`PROD=1 make <target>` does the same thing
# for one invocation; see docs/DEPLOY.md → Version stamping & upgrades.)
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- TLS certificate contact (production overlay) --------------------
# ACME_EMAIL is read by Caddy, not by dzd: deploy/Caddyfile passes it to
# Let's Encrypt as the registration address, which is where expiry and
# problem notices go. Only the production overlay runs Caddy, so this is
# only needed on a host that also sets COMPOSE_FILE above. Uncomment and
# use an address a human actually reads — a certificate that silently
# stops renewing is the failure this contact exists to catch.
#ACME_EMAIL=ops@example.com

# ---- Private image registry (production overlay) ---------------------
# Read by Caddy, not by dzd. The production stack pulls its release images
# from a registry running on the same box rather than compiling them there
# (an s-1vcpu-2gb droplet cannot build Go + two frontends inside a deploy
# step's timeout, and the attempt takes the site down while it fails).
#
# Only the PUSH side needs these. CI reaches the registry over the public
# internet, so Caddy fronts it with TLS + basic auth. The host's own pull
# goes to 127.0.0.1:5000 and needs nothing here.
#
# Leaving them unset does not open the registry — it disables the public
# route (deploy/Caddyfile defaults the site address to registry.invalid),
# so Caddy still starts and the app keeps serving. Generate the hash with:
#
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
#
# Then store the PLAINTEXT (never the hash) as the builds.sr.ht file secret
# the docker-image task reads. The hash is what goes here.
#REGISTRY_HOST=registry.dazyflow.app
#REGISTRY_USER=ci
#REGISTRY_PASSWORD_HASH=$2a$14$replace-me-with-a-real-bcrypt-hash

# ---- Reverse proxy --------------------------------------------------
# Honor X-Forwarded-Proto from the proxy when setting the Secure cookie
# flag + HSTS. Set to 1 ONLY behind a trusted TLS-terminating proxy; a
# directly-exposed daemon must leave this off so clients can't spoof the
# header.
DAZYFLOW_TRUST_PROXY_HEADERS=

# ---- Sign-up --------------------------------------------------------
# Set to 1 to enable POST /api/v1/auth/signup for self-serve account
# creation. Off by default — production deployments often prefer
# admin-invite-only.
DAZYFLOW_ENABLE_SIGNUP=

# ---- Session length -------------------------------------------------
# Sessions slide: TTL is the idle timeout (each request while signed in
# pushes expiry forward by it), so an active user is never bounced
# mid-work; an idle one lapses after TTL. MAX_AGE caps total lifetime from
# sign-in even under constant use, forcing a periodic fresh login. Go
# duration strings ("168h" = 7d, "720h" = 30d). Defaults: TTL 7d, MAX_AGE 30d.
DAZYFLOW_SESSION_TTL=168h
DAZYFLOW_SESSION_MAX_AGE=720h

# ---- Support contact (optional) -------------------------------------
# Operator email or URL surfaced to end users when something is
# mis-configured server-side (e.g. OAuth not enabled). Empty = the UI
# shows a generic "contact your administrator" message with no link.
DAZYFLOW_SUPPORT_CONTACT=

# ---- Support tickets + consented flow access (optional) -------------
# Set to 1 to turn on the in-app support surface: customers file tickets
# and chat with support, support agents work a cross-org queue, and an
# agent can request read-only access to ONE flow that an org admin
# approves for a time-boxed window (Admin -> Support access). Even then
# support only ever sees a REDACTED view — no secrets, no run data.
# Off by default: the endpoints return 501 and no session is elevated.
# Enabling it is not enough on its own — provision at least one support
# agent under Admin -> Platform -> Support agents (a platform admin is
# NOT automatically support staff).
DAZYFLOW_SUPPORT_ENABLED=

# ---- Metrics --------------------------------------------------------
# Set to 1 to expose an unauthenticated GET /metrics Prometheus endpoint
# (per-tenant disk-usage gauges + liveness). Off by default — it reveals
# tenant names, so enable only behind a restricted monitoring network.
DAZYFLOW_ENABLE_METRICS=

# ---- Marketing landing page (optional) ------------------------------
# Path INSIDE the container to a static marketing site (the separate
# dazyflow-landing repo: landing.html, style.css, /pricing, /privacy,
# /terms, assets). When set, GET / is auth-gated — anonymous visitors
# get landing.html, signed-in users get the app — and the marketing
# pages/assets serve publicly. Empty (the default) serves the app at /
# for everyone, which is the right posture for a private self-host
# install.
#
# The files live outside this repo, so mount them into the container and
# point this at the mount. Uncomment the `dzd.volumes` landing line in
# docker-compose.yml and set the host path there, then set:
#   DAZYFLOW_LANDING_DIR=/srv/landing
DAZYFLOW_LANDING_DIR=

# ---- Egress allowlist -----------------------------------------------
# Comma-separated allowlist for the http_request node: exact hosts
# (api.stripe.com), wildcards (*.slack.com), or CIDR/IP (203.0.113.0/24).
# Empty = allow any public host (the IP-level SSRF guard still blocks
# private addresses).
DAZYFLOW_HTTP_EGRESS_ALLOW=

# ---- Private-network egress (SSRF guard opt-out) --------------------
# The http_request / http_download / http_upload steps accept an
# `allow_private_networks` param that disables the SSRF guard so a flow
# can reach a private/loopback host. That param is IGNORED unless you set
# this to 1 — otherwise any tenant could use it to reach cloud metadata
# (169.254.169.254), localhost, or internal services. The same guard
# also covers the Postgres/MySQL `dsn` host and the SMTP `host`. Leave
# OFF on any multi-tenant / untrusted deployment.
DAZYFLOW_ALLOW_PRIVATE_EGRESS=

# ---- Geocoding backend (Location / Reverse geocode steps) -----------
# The geo steps (Location's Place lookup, Reverse geocode) need a geocoder.
# Each TENANT picks one under Apps → OpenStreetMap (backend + optional custom
# URL + optional API key); the values below are only the deployment-wide
# DEFAULTS used when a tenant hasn't chosen. Backends: "nominatim" (default,
# no key), "photon" (no key), "locationiq" (hosted, needs an API key). All use
# OpenStreetMap data; an unknown value falls back to nominatim.
#
# The PUBLIC Nominatim/Photon instances are rate-limited (Nominatim: ~1 req/s,
# no bulk use) and shared across every tenant on this deployment from one
# egress IP — so a multi-tenant deployment WILL get throttled or IP-banned on
# them. For real load, self-host and point the matching URL at your instance
# (or have tenants set a custom URL / use LocationIQ with their own key):
DAZYFLOW_GEOCODER=
#   Nominatim API base (default backend):
DAZYFLOW_NOMINATIM_URL=
#   Photon API base (DAZYFLOW_GEOCODER=photon):
DAZYFLOW_PHOTON_URL=
#   LocationIQ API base (DAZYFLOW_GEOCODER=locationiq; the API key is per-tenant):
DAZYFLOW_LOCATIONIQ_URL=

# ---- Shell step (DANGEROUS — off by default) ------------------------
# Set to 1 to register the `shell` step, which runs arbitrary host
# commands as the daemon's user with host filesystem + network access.
# On a multi-tenant deployment it is a full RCE primitive for anyone who
# can run a flow. Enable ONLY
# on a single-tenant / CI box you fully trust. Even when enabled, the
# command's environment is scrubbed of all DAZYFLOW_* variables so the
# master key and other daemon secrets are never exposed to it.
DAZYFLOW_ENABLE_SHELL=

# ---- Inbound webhooks (optional) ------------------------------------
# Slack app Signing Secret — required for /api/v1/events/slack/* to
# accept Slack Events API POSTs. Empty disables the endpoint with 501.
DAZYFLOW_SLACK_SIGNING_SECRET=
# GitHub repo webhook Secret — required for /api/v1/events/github/* to
# accept push + pull_request POSTs. Empty disables the endpoint with 501.
DAZYFLOW_GITHUB_WEBHOOK_SECRET=

# ---- Transactional email (optional) ---------------------------------
# One operator SMTP account for the platform's own mail: invitation
# links and failure-notification emails. Off when unset — invites fall
# back to copy-the-link, failure notifications to webhooks only.
#   smtp://user:pass@mail.example.com:587            STARTTLS (default)
#   smtps://user:pass@mail.example.com:465           implicit TLS
#   smtp://host:25?tls=none                          plaintext (local relay)
DAZYFLOW_SMTP_URL=
# Sender address. Defaults to the URL's username when that's an email.
# Add a display name in RFC 5322 form to control how the sender shows up
# in the recipient's inbox: DAZYFLOW_SMTP_FROM="Dazyflow <hi@dazyflow.app>"
# (the name rides the From: header only; the envelope uses the bare address).
# With the mailer AND DAZYFLOW_PUBLIC_BASE_URL set, signup email
# verification activates automatically: new accounts get a confirmation
# link, the UI nags until it's clicked, and unverified accounts can't
# send invitations (anti-abuse). Runs and sign-in stay open regardless.
DAZYFLOW_SMTP_FROM=

# ---- Billing / plan gates (optional — SaaS only) --------------------
# Leave this WHOLE section blank when self-hosting. All gates are off by
# default, so a self-host is effectively unlimited, and with no Stripe key
# the web UI hides every plan/upgrade/billing surface automatically (it
# shows usage only). You can still comp orgs to Pro or assign custom tiers
# from Admin → Platform without any of these set — see docs/DEPLOY.md,
# "Managing tenants, tiers & entitlements". Set these only on a paid-SaaS
# deployment that charges its tenants through Stripe.
#
# Free-tier cap: how many flow runs a free-plan org may submit per UTC
# calendar month (counted by the usage metering). 0/empty = no gate.
DAZYFLOW_FREE_RUNS_PER_MONTH=
# Set to 0 to make schedules/polling triggers Pro-only: the scheduler
# skips firing for free-plan orgs (manual runs still work; the Usage
# page tells them why). Default 1 = scheduling open to everyone.
DAZYFLOW_FREE_POLLING_TRIGGERS=
# Stripe API key (sk_live_/sk_test_) + the recurring Price the Pro plan
# subscribes to. Both required for the Upgrade (Checkout) and Manage
# billing (portal) buttons; missing leaves those endpoints 501.
DAZYFLOW_STRIPE_SECRET_KEY=
DAZYFLOW_STRIPE_PRICE_ID=
# Stripe webhook endpoint signing secret (whsec_…) — required for
# POST /api/v1/events/stripe to accept subscription lifecycle events
# (checkout.session.completed upgrades; subscription deleted/canceled
# downgrades). Point the Stripe webhook at
# $DAZYFLOW_PUBLIC_BASE_URL/api/v1/events/stripe.
DAZYFLOW_STRIPE_WEBHOOK_SECRET=

# ---- OIDC bearer auth (optional) -------------------------------------
# Accept IdP-issued JWTs (Microsoft Entra, Okta, Google Workspace, any
# OIDC issuer) as API credentials, validated against the issuer's JWKS.
# Setting the issuer turns it on; discovery + signature/expiry/audience
# checks come from the issuer's metadata. Off when empty.
DAZYFLOW_OIDC_ISSUER=
# Expected audience: the client_id the IdP mints tokens for (or set
# DAZYFLOW_OIDC_AUDIENCE when the aud claim differs from the client id).
DAZYFLOW_OIDC_CLIENT_ID=
DAZYFLOW_OIDC_AUDIENCE=
# Claim mapping. TENANT_CLAIM names the claim carrying the Dazyflow
# tenant id (default "tenant"; Entra convention "tid", Google Workspace
# "hd"). ROLES_CLAIM (default "roles") may be a string array, a single
# string, or space-separated; names resolving in the team catalog
# (viewer/editor/admin) grant those permissions, anything else grants
# none.
DAZYFLOW_OIDC_TENANT_CLAIM=
DAZYFLOW_OIDC_ROLES_CLAIM=

# ---- Approval links (optional) --------------------------------------
# Base64-encoded shared secret (>=16 bytes) for signing/verifying
# email/Slack approval-link tokens. Must be identical across nodes in a
# multi-node deployment. Requires DAZYFLOW_PUBLIC_BASE_URL. When set,
# the daemon serves POST /approve/<run>/<node> on the main HTTP listener
# (HMAC-verified, no auth needed); empty leaves the route unregistered.
DAZYFLOW_APPROVAL_HMAC_SECRET=

# ---- OAuth providers --------------------------------------------------
# Provider client_id/secret are NOT configured via env. They're entered
# in the admin UI (Admin -> OAuth providers, /admin/oauth) and persisted
# to the encrypted store (requires DAZYFLOW_PUBLIC_BASE_URL so the
# redirect_uri can be built). Installed integrations register their
# provider via daemon.RegisterFromManifest. NOTE: /admin/oauth is
# platform:admin-only — see DAZYFLOW_PLATFORM_ADMINS below.

# ---- Platform admins (instance super-admins) ------------------------
# Comma-separated email allowlist. Listed users get the platform:admin
# role — the cross-tenant super-admin needed to reach instance-wide
# config like /admin/oauth (OAuth provider apps).
# This is the ONLY way to bootstrap platform:admin (only a platform
# admin can grant it otherwise), so set at least your own email here for
# a fresh install. The role is stamped onto the session at sign-in, so
# changes take effect on next login. Empty = no platform admins.
#
# Bootstrap: emails listed here may sign up via POST /api/v1/auth/signup
# even when DAZYFLOW_ENABLE_SIGNUP is off — so a fresh instance can mint
# its first super-admin without temporarily opening signup to the world.
# Self-limiting: once the account exists, a second signup for that email
# is rejected as a duplicate. Signup stays closed for everyone else.
DAZYFLOW_PLATFORM_ADMINS=

# ---- Update check (optional) ----------------------------------------
# The admin → System section tells a platform admin whether a newer
# release exists. It reads build.version from a canonical deployment's
# public GET /api/v1 (no auth, no token) and compares it to this build.
# The check fires only when an admin opens the page — not in the
# background. Defaults to the project's production origin; set to a blank
# value to disable the check entirely (the page still loads).
DAZYFLOW_UPDATE_URL=https://dazyflow.r8.rs/api/v1

# ---- Connection pool (optional) -------------------------------------
# Size the shared Postgres pool for production: workers + gateway +
# scheduler + reaper all share it. Empty defaults to max=20, min=2 (dzd
# overrides pgx's too-small max(4, NumCPU) default). Bump max under heavy
# concurrent load; keep N_replicas * max under Postgres max_connections.
DAZYFLOW_PG_MAX_CONNS=
DAZYFLOW_PG_MIN_CONNS=

# ---- Workers (optional) ---------------------------------------------
# Flow-execution workers per process. Each runs one node at a time, so
# this is the per-process execution concurrency. Default 2. Raise on an
# execution-heavy node, or add dzd replicas (the job queue claims with
# FOR UPDATE SKIP LOCKED, so both are safe).
DAZYFLOW_WORKER_COUNT=

# Name for THIS dzd process in the job queue. Defaults to hostname+PID,
# which is already unique per process — set it only if you'd rather name
# your instances. It must stay distinct per running process: the queue
# fences a worker's writes on this name, so two processes sharing it can
# each write over work the other claimed.
DAZYFLOW_WORKER_ID=

# ---- Session lookup cache (optional) --------------------------------
# Short in-process cache for session-token validation (the per-request
# auth lookup). Collapses repeated lookups to ~1 DB query per token per
# window. Same-instance sign-out invalidates immediately; the TTL only
# bounds cross-instance revocation lag. Default 15s; 0 disables.
DAZYFLOW_SESSION_CACHE_TTL=

# ---- Retention (optional) -------------------------------------------
# The jobs table (run history + payloads), audit_events, and run_logs
# grow without bound otherwise. A background sweep (hourly) deletes
# terminal job rows, audit rows, and run-log rows older than these
# windows. Postgres-only. 0 disables a sweep (keep forever). Defaults:
# jobs 30d (720h), audit 90d (2160h), run logs follow the job window
# (a run's log shouldn't outlive the run record it narrates).
DAZYFLOW_JOB_RETENTION=
DAZYFLOW_AUDIT_RETENTION=
DAZYFLOW_RUN_LOG_RETENTION=

# Run-log payload content (GDPR P2.1). Run logs capture streamed
# stdout/stderr and progress lines, which can echo personal data from a
# flow. Set to false to persist only the node status + terminal trail
# (no payload content), keeping run history auditable without the PII.
# Default true. Per-run deletion is also available via
# DELETE /api/v1/me/runs/{run_id}/logs.
DAZYFLOW_LOG_RUN_PAYLOADS=true

# Audit secret READS (compliance). When set, every successful secret
# resolution writes a "secret.read" audit event (secret name + actor, never
# the value) to the Postgres audit trail. Off by default: secret resolution
# runs on every node execution, so this is high-volume — enable only when a
# compliance regime requires a read trail. Postgres-only (needs the audit log).
DAZYFLOW_AUDIT_SECRET_READS=

# ---- Graph timeout ceiling (optional) -------------------------------
# Hard ceiling on a run's wall-time (Go duration; 0 = no ceiling).
# Clamps even an explicit per-graph timeout_seconds, and acts as the
# default for graphs that declare no timeout of their own.
DAZYFLOW_MAX_GRAPH_TIMEOUT=

# ---- Secrets --------------------------------------------------------
# Secrets live in the per-tenant encrypted store (set via the API / UI)
# and are referenced from flows as ${secret.NAME}.

# ---- Module registries (optional) -----------------------------------
# Register remote gRPC modules: id1=host:port,id2=host:port (insecure
# dial; intended for dev / examples).
DAZYFLOW_REMOTE_MODULES=
# Register MCP stdio servers for the WHOLE deployment: name=command [args];
# semicolon-separated. Each one starts a process on this host as the daemon
# user, which is why it is an operator setting and not something an org admin
# can reach. Its tools are visible to every org.
#
# Orgs add their own MCP servers in the UI (Admin -> MCP servers), over HTTP —
# a URL and a token, no process started here. That path needs no configuration:
# it is on whenever Postgres is. See docs/guide/mcp-servers.md.
DAZYFLOW_MCP_SERVERS=

# ---- Observability (optional) ---------------------------------------
# Export traces to an OpenTelemetry collector. Empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Timezone -------------------------------------------------------
# Cron schedules are evaluated in this timezone — "0 8 * * *" means 08:00
# here, not 08:00 UTC.
TZ=UTC

# ---- Postgres container (compose only) ------------------------------
# Used by the bundled `postgres` service in docker-compose.yml. Change
# POSTGRES_PASSWORD before going to production (and update
# DAZYFLOW_POSTGRES_DSN above to match).
POSTGRES_DB=dazyflow
POSTGRES_USER=dazyflow
POSTGRES_PASSWORD=dazyflow

# ---- Container layout (advanced) ------------------------------------
# These are baked into the image as ENV (see Dockerfile) so you only
# need to override them when running dzd outside the supplied
# Dockerfile/compose stack. Listed here for completeness:
#
#   DAZYFLOW_LISTEN=:50050   # gRPC bind addr
#   DAZYFLOW_HTTP=:8080      # HTTP /api/v1 + web bundle
#   DAZYFLOW_WEB_DIST=/srv/web   # built SPA dir
#   DAZYFLOW_DATA_DIR=/data  # holds workspace/, sandbox/, state/
#
# Local dev convenience (NOT for production):
#
#   DAZYFLOW_DEV_KEY=1       # mint an insecure dev API key on startup
#   DAZYFLOW_DEV=1           # downgrade the fail-closed config guard
#                            # (default DB password / empty master key)
#                            # from fatal to warnings, so the bundled
#                            # defaults boot for a throwaway local trial
#
# Operational tuning (sane defaults; rarely changed):
#
#   DAZYFLOW_SHUTDOWN_GRACE=25s   # how long shutdown waits for in-flight
#                                 # nodes to finish before exiting; keep it
#                                 # under your orchestrator's termination
#                                 # grace (e.g. k8s terminationGracePeriodSeconds)
#   DAZYFLOW_REAP_INTERVAL=1m     # how often the orphaned-graph-run reaper sweeps
