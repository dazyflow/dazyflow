{
  "name": "dazyflow-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Dazyflow visual editor — React + React Flow over the daemon HTTP gateway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:docs": "tsc -b && vite build --mode docs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/check-css-tokens.mjs && node scripts/check-css-classes.mjs && node scripts/check-css-breakpoints.mjs && node scripts/check-icon-sizes.mjs && node scripts/check-modal-a11y.mjs && node scripts/check-ui-primitives.mjs && node scripts/check-style-scales.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.3.5",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
