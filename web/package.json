{
  "name": "dazyflow-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Dazyflow visual editor \u2014 React + React Flow over the daemon HTTP gateway.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:docs": "tsc -b && vite build --mode docs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "eslint src --quiet && tsc -p tsconfig.test.json --noEmit && node scripts/check-css-tokens.mjs && node scripts/check-css-classes.mjs && node scripts/check-css-breakpoints.mjs && node scripts/check-icon-sizes.mjs && node scripts/check-modal-a11y.mjs && node scripts/check-ui-primitives.mjs && node scripts/check-style-scales.mjs && node scripts/check-wide-tables.mjs && node scripts/check-overlay-metrics.mjs && node scripts/check-eager-locales.mjs && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
