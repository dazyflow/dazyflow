{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Explicit, so that adding an @types package for the TEST config (see
    // tsconfig.test.json, which needs @types/node for the guard tests that read
    // files off disk) does not silently hand the browser bundle `process`,
    // `__dirname` and `node:fs` as valid globals. Everything the app needs is
    // either imported or declared in src/vite-env.d.ts.
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
