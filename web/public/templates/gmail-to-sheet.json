{
  "id": "gmail-to-sheet",
  "version": "1",
  "name": "New Gmail → log to Sheet",
  "description": "Polls Gmail every 5 minutes for messages from the last few minutes and appends each to a Google Sheet. for_each fans the message IDs out to gmail_get_message; unwrap_results flattens the per-item results back into plain rows so compute_rows can read row.headers.* directly, and map_rows keeps just the columns you want. (A short poll window means an overlap can occasionally re-log a message.)",
  "icon": "mail",
  "triggers": [
    {"type": "poll", "interval_seconds": 300}
  ],
  "nodes": [
    {
      "id": "search",
      "module": "gmail_search_messages",
      "params": {
        "query": "newer_than:6m label:inbox",
        "max_results": 20,
        "account": "default"
      },
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "fetch",
      "module": "for_each",
      "params": {
        "step_module": "gmail_get_message",
        "step_params": {
          "id": "${item:id}",
          "account": "default",
          "format": "metadata"
        }
      },
      "position": {"x": 520, "y": 200}
    },
    {
      "id": "unwrap",
      "module": "unwrap_results",
      "params": {"port": "message"},
      "position": {"x": 840, "y": 200}
    },
    {
      "id": "flatten",
      "module": "compute_rows",
      "params": {
        "compute": {
          "from": "row.headers.From",
          "subject": "row.headers.Subject",
          "received": "row.headers.Date"
        }
      },
      "position": {"x": 1160, "y": 200}
    },
    {
      "id": "shape",
      "module": "map_rows",
      "params": {
        "select": ["from", "subject", "received"]
      },
      "position": {"x": 1480, "y": 200}
    },
    {
      "id": "log",
      "module": "sheets_append_row",
      "params": {
        "spreadsheet_id": "REPLACE_WITH_YOUR_SHEET_ID",
        "range": "Inbox Log",
        "account": "default"
      },
      "position": {"x": 1800, "y": 200}
    }
  ],
  "edges": [
    {"from": "search", "from_port": "messages", "to": "fetch", "to_port": "items", "on_error": ""},
    {"from": "fetch", "from_port": "results", "to": "unwrap", "to_port": "results", "on_error": ""},
    {"from": "unwrap", "from_port": "rows", "to": "flatten", "to_port": "rows", "on_error": ""},
    {"from": "unwrap", "from_port": "headers", "to": "flatten", "to_port": "headers", "on_error": ""},
    {"from": "flatten", "from_port": "rows", "to": "shape", "to_port": "rows", "on_error": ""},
    {"from": "flatten", "from_port": "headers", "to": "shape", "to_port": "headers", "on_error": ""},
    {"from": "shape", "from_port": "rows", "to": "log", "to_port": "rows", "on_error": ""},
    {"from": "shape", "from_port": "headers", "to": "log", "to_port": "headers", "on_error": ""}
  ]
}
