{
  "id": "gmail-to-sheet",
  "version": "1",
  "name": "New Gmail \u2192 log to Sheet",
  "description": "Polls Gmail for recent matching messages and appends them to a Google Sheet.",
  "icon": "mail",
  "triggers": [
    {
      "type": "poll",
      "interval_seconds": 300
    }
  ],
  "nodes": [
    {
      "id": "search",
      "module": "gmail_search_messages",
      "params": {
        "query": "newer_than:5m label:inbox",
        "max_results": 20,
        "account": "default"
      },
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "fetch",
      "module": "for_each",
      "params": {
        "step": "gmail_get_message",
        "step_params": {
          "id": "${item:id}",
          "account": "default",
          "format": "metadata"
        }
      },
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "shape",
      "module": "compute_rows",
      "params": {
        "compute": {
          "from": "row.headers.From",
          "subject": "row.headers.Subject",
          "received": "row.headers.Date"
        }
      },
      "position": {
        "x": 1000,
        "y": 200
      }
    },
    {
      "id": "log",
      "module": "sheets_append_row",
      "params": {
        "spreadsheet_id": "REPLACE_WITH_YOUR_SHEET_ID",
        "range": "Inbox Log",
        "account": "default"
      },
      "position": {
        "x": 1300,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "from": "search",
      "from_port": "messages",
      "to": "fetch",
      "to_port": "items",
      "on_error": ""
    },
    {
      "from": "fetch",
      "from_port": "results",
      "to": "shape",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "shape",
      "from_port": "rows",
      "to": "log",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "shape",
      "from_port": "headers",
      "to": "log",
      "to_port": "headers",
      "on_error": ""
    }
  ]
}
