{
  "id": "daily-sheet-to-pdf-email",
  "version": "1",
  "name": "Daily Sheet → PDF → email me",
  "description": "Every morning, render a Google Sheet as a PDF and email it to yourself. Paste your sheet's URL (or its ID) into the export node, set your address in the email node, and you're done.",
  "icon": "mail",
  "triggers": [
    {"type": "cron", "cron": "0 9 * * *"}
  ],
  "nodes": [
    {
      "id": "render",
      "module": "sheets_export_pdf",
      "params": {
        "account": "default",
        "spreadsheet_id": "REPLACE_WITH_YOUR_SHEET_URL_OR_ID"
      },
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "email",
      "module": "gmail_send_email",
      "params": {
        "account": "default",
        "to": "REPLACE_WITH_YOUR_EMAIL_ADDRESS",
        "subject": "Your daily report",
        "body": "PDF of today's sheet attached."
      },
      "position": {"x": 540, "y": 200}
    }
  ],
  "edges": [
    {"from": "render", "from_port": "pdf", "to": "email", "to_port": "attachments[0]", "on_error": ""}
  ]
}
