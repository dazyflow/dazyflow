{
  "id": "email-to-sheet",
  "version": "1",
  "name": "Save incoming emails to a Google Sheet",
  "description": "Checks Gmail every few minutes for new inbox messages and adds each one (sender, subject, date) as a row in a Google Sheet — a tidy log of who emailed you. Gmail search already returns full emails, so it's just three steps. Narrow the search query to log only what you care about (e.g. invoices or enquiries).",
  "icon": "mail",
  "nodes": [
    {
      "id": "poll",
      "module": "poll_trigger",
      "params": { "interval_seconds": 300 },
      "position": { "x": 100, "y": 200 }
    },
    {
      "id": "search",
      "module": "gmail_search_messages",
      "params": {
        "query": "newer_than:6m label:inbox",
        "max_results": 20,
        "account": "default"
      },
      "position": { "x": 420, "y": 200 }
    },
    {
      "id": "shape",
      "module": "map_rows",
      "params": { "select": ["from", "subject", "date"] },
      "position": { "x": 740, "y": 200 }
    },
    {
      "id": "append",
      "module": "sheets_append_row",
      "params": {
        "spreadsheet_id": "REPLACE_WITH_YOUR_SHEET_ID",
        "range": "Inbox Log",
        "account": "default"
      },
      "position": { "x": 1060, "y": 200 }
    }
  ],
  "edges": [
    { "from": "search", "from_port": "messages", "to": "shape", "to_port": "rows", "on_error": "" },
    { "from": "shape", "from_port": "rows", "to": "append", "to_port": "rows", "on_error": "" },
    { "from": "shape", "from_port": "headers", "to": "append", "to_port": "headers", "on_error": "" }
  ]
}
