{
  "id": "daily-reminder-ntfy",
  "version": "1",
  "name": "Daily reminder to your phone",
  "description": "A Schedule step fires every morning at 09:00 and an ntfy step pushes a notification to a topic you choose. No accounts to connect — just pick a topic and subscribe to it in the ntfy app.",
  "icon": "ntfy",
  "nodes": [
    {
      "id": "schedule",
      "module": "cron_trigger",
      "params": {
        "cron": "0 9 * * *"
      },
      "position": { "x": 240, "y": 200 }
    },
    {
      "id": "notify",
      "module": "ntfy",
      "params": {
        "topic": "my-daily-hello",
        "message": "Hello! Your daily reminder.",
        "title": "Daily reminder"
      },
      "position": { "x": 560, "y": 200 }
    }
  ],
  "edges": [
    {"from": "schedule", "from_port": "fired_at", "to": "notify", "to_port": "pass", "on_error": ""}
  ]
}
