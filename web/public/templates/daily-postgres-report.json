{
  "id": "daily-postgres-report",
  "version": "1",
  "name": "Daily Postgres → Slack digest",
  "description": "Every morning at 09:00, runs a SELECT and posts a one-line summary to Slack — e.g. 'Last 24h: 37 new orders'. render_text turns the result row into the message string, and the edge into Slack's body is what sequences the post after the query. Wire your own SQL + channel; the shape stays.",
  "icon": "clock",
  "triggers": [
    {
      "type": "cron",
      "cron": "0 9 * * *"
    }
  ],
  "nodes": [
    {
      "id": "query",
      "module": "postgres_query",
      "params": {
        "dsn": "${secret.postgres_dsn}",
        "sql": "SELECT count(*) AS total FROM orders WHERE created_at > now() - interval '24 hours'"
      },
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "render",
      "module": "render_text",
      "params": {
        "template": "'Last 24h: ' + string(row.total) + ' new orders'"
      },
      "position": {
        "x": 520,
        "y": 200
      }
    },
    {
      "id": "notify",
      "module": "slack_send_message",
      "params": {
        "channel": "#metrics",
        "account": "default"
      },
      "position": {
        "x": 840,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "from": "query",
      "from_port": "rows",
      "to": "render",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "query",
      "from_port": "columns",
      "to": "render",
      "to_port": "headers",
      "on_error": ""
    },
    {
      "from": "render",
      "from_port": "text",
      "to": "notify",
      "to_port": "text",
      "on_error": ""
    }
  ]
}