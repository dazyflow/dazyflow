{
  "id": "stripe-payment-to-slack",
  "version": "1",
  "name": "Stripe payment → Slack ping",
  "description": "Polls Stripe every 5 minutes for new successful payments and posts one Slack message per payment. The cursor pattern makes each event fire exactly once: 'List events' reads the saved cursor from the STRIPE_EVENT_CURSOR secret, only returns events newer than it, and 'Set secret' saves the newest event id for the next poll. Before the first run, add two secrets: STRIPE_API_KEY (your sk_… key) and STRIPE_EVENT_CURSOR with the placeholder value \"-\" (the first poll replaces it with a real event id).",
  "icon": "credit-card",
  "nodes": [
    {
      "id": "poll",
      "module": "poll_trigger",
      "params": { "interval_seconds": 300 },
      "position": { "x": -120, "y": 200 }
    },
    {
      "id": "events",
      "module": "stripe_list_events",
      "params": {
        "api_key": "${secret.STRIPE_API_KEY}",
        "types": ["payment_intent.succeeded"],
        "after_id": "${secret.STRIPE_EVENT_CURSOR}",
        "limit": 50
      },
      "position": { "x": 200, "y": 200 }
    },
    {
      "id": "notify",
      "module": "for_each",
      "params": {
        "step_module": "slack_send_message",
        "step_params": {
          "channel": "#payments",
          "account": "default",
          "text": "💰 New Stripe payment — ${item.id} (${item.type})"
        }
      },
      "position": { "x": 520, "y": 120 }
    },
    {
      "id": "save",
      "module": "secret_set",
      "params": { "name": "STRIPE_EVENT_CURSOR" },
      "position": { "x": 520, "y": 320 }
    }
  ],
  "edges": [
    {
      "from": "events",
      "from_port": "events",
      "to": "notify",
      "to_port": "items",
      "on_error": ""
    },
    {
      "from": "events",
      "from_port": "last_id",
      "to": "save",
      "to_port": "value",
      "on_error": ""
    }
  ]
}
