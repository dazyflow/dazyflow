{
  "id": "webhook-to-slack",
  "version": "1",
  "name": "Webhook to Slack notification",
  "description": "Catches an inbound HTTP POST and posts its JSON body to a Slack channel. render_text renders the payload into a string Slack can display (a raw body could be any shape; Slack's message needs text). Useful for piping alerts from external systems — monitoring, CI, Stripe events — into your team chat.",
  "icon": "webhook",
  "nodes": [
    {
      "id": "trigger",
      "module": "webhook_input",
      "params": {},
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "render",
      "module": "render_text",
      "params": {
        "template": "row"
      },
      "position": {
        "x": 540,
        "y": 200
      }
    },
    {
      "id": "notify",
      "module": "slack_send_message",
      "params": {
        "channel": "#data-ops",
        "account": "default"
      },
      "position": {
        "x": 880,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "from_port": "body",
      "to": "render",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "render",
      "from_port": "text",
      "to": "notify",
      "to_port": "body",
      "on_error": ""
    }
  ]
}
