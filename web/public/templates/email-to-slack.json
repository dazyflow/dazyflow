{
  "id": "email-to-slack",
  "version": "1",
  "name": "New email → Slack message",
  "description": "Checks Gmail every few minutes and posts a one-line Slack message for each new inbox email — sender and subject — so your team sees it in chat without watching the inbox. Gmail search already returns full emails, so it's just three steps. Point it at any channel and tighten the search to only what matters.",
  "icon": "mail",
  "nodes": [
    {
      "id": "poll",
      "module": "poll_trigger",
      "params": {
        "interval_seconds": 300
      },
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "search",
      "module": "gmail_search_messages",
      "params": {
        "query": "newer_than:6m label:inbox",
        "only_new": true,
        "max_results": 20,
        "account": "default"
      },
      "position": {
        "x": 420,
        "y": 200
      }
    },
    {
      "id": "render",
      "module": "render_text",
      "params": {
        "template": "'• ' + row.from + ': ' + row.subject",
        "prefix": "*New mail*\n",
        "empty": "No new mail."
      },
      "position": {
        "x": 740,
        "y": 200
      }
    },
    {
      "id": "notify",
      "module": "slack_send_message",
      "params": {
        "channel": "#inbox",
        "account": "default"
      },
      "position": {
        "x": 1060,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "from": "search",
      "from_port": "messages",
      "to": "render",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "render",
      "from_port": "text",
      "to": "notify",
      "to_port": "text",
      "on_error": ""
    }
  ]
}
