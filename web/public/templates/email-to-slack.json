{
  "id": "email-to-slack",
  "version": "1",
  "name": "New email → Slack message",
  "description": "Checks Gmail every few minutes and posts a one-line Slack message for each new inbox email — sender and subject — so your team sees it in chat without watching the inbox. Point it at any channel and tighten the search to only what matters.",
  "icon": "mail",
  "nodes": [
    {
      "id": "poll",
      "module": "poll_trigger",
      "params": { "interval_seconds": 300 },
      "position": { "x": -120, "y": 200 }
    },
    {
      "id": "search",
      "module": "gmail_search_messages",
      "params": {
        "query": "newer_than:6m label:inbox",
        "max_results": 20,
        "account": "default"
      },
      "position": { "x": 200, "y": 200 }
    },
    {
      "id": "fetch",
      "module": "for_each",
      "params": {},
      "position": { "x": 520, "y": 200 }
    },
    {
      "id": "get",
      "module": "gmail_get_message",
      "params": { "id": "${item.id}", "account": "default", "format": "metadata" },
      "position": { "x": 520, "y": 360 }
    },
    {
      "id": "unwrap",
      "module": "unwrap_results",
      "params": { "port": "message" },
      "position": { "x": 840, "y": 200 }
    },
    {
      "id": "render",
      "module": "render_text",
      "params": {
        "template": "'• ' + row.headers.From + ': ' + row.headers.Subject",
        "prefix": "*New mail*\n",
        "empty": "No new mail."
      },
      "position": { "x": 1160, "y": 200 }
    },
    {
      "id": "notify",
      "module": "slack_send_message",
      "params": { "channel": "#inbox", "account": "default" },
      "position": { "x": 1480, "y": 200 }
    }
  ],
  "edges": [
    { "from": "search", "from_port": "messages", "to": "fetch", "to_port": "items", "on_error": "" },
    { "from": "fetch", "from_port": "body", "to": "get", "to_port": "pass", "on_error": "" },
    { "from": "fetch", "from_port": "results", "to": "unwrap", "to_port": "results", "on_error": "" },
    { "from": "unwrap", "from_port": "rows", "to": "render", "to_port": "rows", "on_error": "" },
    { "from": "render", "from_port": "text", "to": "notify", "to_port": "text", "on_error": "" }
  ]
}
