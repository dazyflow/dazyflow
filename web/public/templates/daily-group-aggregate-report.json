{
  "id": "daily-group-aggregate-report",
  "version": "1",
  "name": "Daily group-by report \u2192 Slack",
  "description": "Every morning at 09:00, queries yesterday's orders from Postgres, groups them by country with sum/avg/count aggregations, formats a one-line summary per country, and posts to Slack. Demonstrates group_aggregate composing with compute_rows for the final string render.",
  "icon": "clock",
  "triggers": [
    {
      "type": "cron",
      "cron": "0 9 * * *"
    }
  ],
  "nodes": [
    {
      "id": "query",
      "module": "postgres_query",
      "params": {
        "dsn": "${tenant:postgres_dsn}",
        "sql": "SELECT country, amount FROM orders WHERE created_at::date = current_date - 1"
      },
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "summarize",
      "module": "group_aggregate",
      "params": {
        "by": [
          "country"
        ],
        "aggregate": {
          "orders": {
            "op": "count"
          },
          "revenue": {
            "op": "sum",
            "column": "amount"
          },
          "avg_ticket": {
            "op": "avg",
            "column": "amount"
          }
        }
      },
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "render",
      "module": "compute_rows",
      "params": {
        "compute": {
          "line": "row.country + ': ' + string(row.orders) + ' orders, $' + string(row.revenue) + ' total, avg $' + string(row.avg_ticket)"
        }
      },
      "position": {
        "x": 1000,
        "y": 200
      }
    },
    {
      "id": "notify",
      "module": "slack_send_message",
      "params": {
        "channel": "#ops-daily",
        "account": "default",
        "text": "${upstream:render.rows[0].line}"
      },
      "position": {
        "x": 1300,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "from": "query",
      "from_port": "rows",
      "to": "summarize",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "query",
      "from_port": "columns",
      "to": "summarize",
      "to_port": "headers",
      "on_error": ""
    },
    {
      "from": "summarize",
      "from_port": "rows",
      "to": "render",
      "to_port": "rows",
      "on_error": ""
    },
    {
      "from": "summarize",
      "from_port": "headers",
      "to": "render",
      "to_port": "headers",
      "on_error": ""
    },
    {
      "from": "render",
      "from_port": "rows",
      "to": "notify",
      "to_port": "body",
      "on_error": ""
    }
  ]
}
