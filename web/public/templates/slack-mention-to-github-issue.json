{
  "id": "slack-mention-to-github-issue",
  "version": "1",
  "name": "Slack mention → GitHub issue",
  "description": "When your bot is @-mentioned in Slack, opens a GitHub issue with the mention text as the body — routing 'hey can someone look at X' into a tracked queue instead of chat scrollback. compute_rows builds the title and body fields; render_text feeds the body as a clean string into the issue, while the title rides in as a param.",
  "icon": "git-branch",
  "nodes": [
    {
      "id": "mention",
      "module": "slack_on_mention",
      "params": {},
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "shape",
      "module": "compute_rows",
      "params": {
        "compute": {
          "title": "'Slack mention from @' + row.user",
          "body": "'Channel: ' + row.channel + '\\n\\n' + row.text"
        }
      },
      "position": {"x": 540, "y": 200}
    },
    {
      "id": "render",
      "module": "render_text",
      "params": {"column": "body"},
      "position": {"x": 880, "y": 200}
    },
    {
      "id": "ticket",
      "module": "github_create_issue",
      "params": {
        "account": "default",
        "owner": "REPLACE_OWNER",
        "repo": "REPLACE_REPO",
        "title": "${upstream:shape.rows[0].title}",
        "labels": ["from-slack"]
      },
      "position": {"x": 1220, "y": 200}
    }
  ],
  "edges": [
    {"from": "mention", "from_port": "event", "to": "shape", "to_port": "rows", "on_error": ""},
    {"from": "shape", "from_port": "rows", "to": "render", "to_port": "rows", "on_error": ""},
    {"from": "render", "from_port": "text", "to": "ticket", "to_port": "body", "on_error": ""}
  ]
}
