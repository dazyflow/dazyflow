{
  "id": "payment-to-thanks-and-log",
  "version": "1",
  "name": "Stripe payment → thank-you, team ping, sales log",
  "description": "When a payment succeeds, the customer gets a thank-you email, the team channel gets a line about it, and the sale is recorded in a Collection — so nobody retypes an order anywhere. The log is keyed on the payment id, so a Stripe webhook retry updates the same row instead of adding a duplicate.",
  "icon": "database",
  "nodes": [
    {
      "id": "paid",
      "module": "stripe_on_payment",
      "params": {},
      "position": { "x": 120, "y": 220 }
    },
    {
      "id": "thanks",
      "module": "gmail_send_email",
      "params": {
        "account": "default",
        "subject": "Thanks for your order",
        "body": "Thank you! We have received your payment and are getting your order ready."
      },
      "position": { "x": 480, "y": 60 }
    },
    {
      "id": "ping_text",
      "module": "render_template",
      "params": {
        "template": "Payment {{.amount}} {{.currency}} from {{.receipt_email}} — {{.description}}"
      },
      "position": { "x": 480, "y": 220 }
    },
    {
      "id": "ping",
      "module": "slack_send_message",
      "params": { "channel": "#sales", "account": "default" },
      "position": { "x": 840, "y": 220 }
    },
    {
      "id": "row",
      "module": "map_rows",
      "params": {
        "select": ["id", "receipt_email", "amount", "currency", "description"],
        "rename": { "id": "payment_id", "receipt_email": "email" }
      },
      "position": { "x": 480, "y": 380 }
    },
    {
      "id": "log",
      "module": "builtin_store_append",
      "params": { "table": "sales", "unique_by": ["payment_id"] },
      "position": { "x": 840, "y": 380 }
    }
  ],
  "edges": [
    { "from": "paid", "from_port": "customer_email", "to": "thanks", "to_port": "to", "on_error": "" },
    { "from": "paid", "from_port": "payment", "to": "ping_text", "to_port": "data", "on_error": "" },
    { "from": "ping_text", "from_port": "html", "to": "ping", "to_port": "text", "on_error": "" },
    { "from": "paid", "from_port": "payment", "to": "row", "to_port": "rows", "on_error": "" },
    { "from": "row", "from_port": "rows", "to": "log", "to_port": "rows", "on_error": "" }
  ]
}
