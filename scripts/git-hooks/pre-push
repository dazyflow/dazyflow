#!/usr/bin/env bash
# pre-push — the local gate. Runs `make check` (go build, go vet, go test)
# before a push leaves the machine.
#
# Why this exists: sourcehut's builds.sr.ht is ADVISORY — it runs after a
# push and reports status, it does not block. A red build there stops
# nothing. This hook is the only thing that actually prevents pushing a
# broken tree, which is how the e2e suite once went red unnoticed.
#
# Scope: the fast Go gate, not the full CI. The race detector and the web
# build live in `make ci` and in CI itself — they're too slow to run on
# every push without the hook getting bypassed out of habit.
#
# Install once with: make hooks
# Bypass in a genuine emergency with: git push --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "pre-push: running 'make check' (build, vet, tests)…"
if ! make check; then
	echo >&2
	echo "pre-push: checks FAILED — push aborted." >&2
	echo "          fix the above, or bypass with: git push --no-verify" >&2
	exit 1
fi
echo "pre-push: checks passed."
